# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# The repo is public; a committed key is scraped and revoked within minutes.

# groq | gemini | bedrock | ollama | fallback
PARSE_MODEL_PROVIDER=groq

# Groq: far higher free limits than Gemini. Key: https://console.groq.com/keys
# The model must support tool use (structured output); check Groq's current
# model list, they retire ids periodically.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: https://aistudio.google.com/apikey  (free tier throttles quickly)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
