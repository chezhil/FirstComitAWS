# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# The repo is public; a committed key is scraped and revoked within minutes.

# bedrock (default) | gemini | ollama | fallback
PARSE_MODEL_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
